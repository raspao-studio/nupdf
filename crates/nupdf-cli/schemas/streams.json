{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.streams/v1",
  "title": "nupdf.streams/v1",
  "description": "Decode every stream: length and BLAKE3 of the data.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "object_count": {
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "streams": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "blake3": {
            "type": "string"
          },
          "image": {
            "type": "boolean"
          },
          "len": {
            "type": "integer"
          }
        }
      }
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "object_count",
    "schema",
    "streams"
  ]
}
