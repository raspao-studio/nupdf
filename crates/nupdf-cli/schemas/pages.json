{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.pages/v1",
  "title": "nupdf.pages/v1",
  "description": "List pages with their inherited MediaBox, CropBox, Rotate and Resources; or, with --select, --delete or --rotate, write the document with its pages changed.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "kept": {
      "type": "null"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": "null"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "after": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "after",
              "before",
              "name"
            ]
          }
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "page_count_after": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "CropBox": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "integer",
                "object"
              ],
              "properties": {
                "r": {
                  "type": "number"
                }
              },
              "required": [
                "r"
              ]
            }
          },
          "MediaBox": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "integer",
                "object"
              ],
              "properties": {
                "r": {
                  "type": "number"
                }
              },
              "required": [
                "r"
              ]
            }
          },
          "Resources": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ref": {
                "type": "string"
              }
            }
          },
          "Rotate": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": "string"
          },
          "object": {
            "type": "string"
          }
        }
      }
    },
    "rotated": {
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "objects",
        "verified"
      ]
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "schema"
  ]
}
