{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.error/v1",
  "title": "nupdf.error/v1",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "error",
    "schema"
  ]
}
