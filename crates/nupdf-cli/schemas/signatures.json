{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.signatures/v1",
  "title": "nupdf.signatures/v1",
  "description": "Each page's signature fields: signed or not, the signatory, reason, time, the byte ranges signed, whether the file changed after signing, and whether the signed digest matches the signed bytes.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "signatures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "byte_range": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "changed_since_signing": {
                  "type": "boolean"
                },
                "contents_length": {
                  "type": "integer"
                },
                "digest": {
                  "type": "string"
                },
                "filter": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "location": {
                  "type": "null"
                },
                "name": {
                  "type": "string"
                },
                "reason": {
                  "type": "null"
                },
                "signatory": {
                  "type": "string"
                },
                "signed": {
                  "type": "boolean"
                },
                "signer_name": {
                  "type": "string"
                },
                "signing_time": {
                  "type": "integer"
                },
                "sub_filter": {
                  "type": "string"
                }
              },
              "required": [
                "byte_range",
                "changed_since_signing",
                "contents_length",
                "digest",
                "filter",
                "id",
                "location",
                "name",
                "reason",
                "signatory",
                "signed",
                "signer_name",
                "signing_time",
                "sub_filter"
              ]
            }
          }
        },
        "required": [
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ]
}
