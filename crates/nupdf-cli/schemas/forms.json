{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.forms/v1",
  "title": "nupdf.forms/v1",
  "description": "Each page's form widgets: field name, label, type, flags, value, options, maximum length, whether read-only or signed; and whether the form is an XFA form.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "need_appearances": {
      "type": "boolean"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "widgets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "flags": {
                  "type": "integer"
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "max_len": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "object": {
                  "type": "integer"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "export": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "export",
                      "text"
                    ]
                  }
                },
                "read_only": {
                  "type": "boolean"
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "signed": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "flags",
                "id",
                "label",
                "name",
                "object",
                "read_only",
                "rect",
                "type",
                "value"
              ]
            }
          }
        },
        "required": [
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    },
    "xfa": {
      "type": "boolean"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "need_appearances",
    "page_count",
    "pages",
    "schema",
    "xfa"
  ]
}
