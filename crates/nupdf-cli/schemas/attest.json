{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.attest/v1",
  "title": "nupdf.attest/v1",
  "description": "Attest each page's perceptual truth against its stream text: pixel contrast against a text-free render, vector strikethrough, underline and box markup, ActualText mismatches, unmapped glyphs, and PNG crops of unexplained graphic blind spots.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actual_text_mismatches": {
            "type": "integer"
          },
          "blind_spots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "crop_file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "page": {
                  "type": "integer"
                },
                "path_ops": {
                  "type": "integer"
                }
              },
              "required": [
                "bbox",
                "crop_file",
                "id",
                "kind",
                "page",
                "path_ops"
              ]
            }
          },
          "hidden_or_occluded_spans": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "span_count": {
            "type": "integer"
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "boxed": {
                  "type": "boolean"
                },
                "glyph_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "hazards": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "id": {
                  "type": "string"
                },
                "max_contrast": {
                  "type": "integer"
                },
                "page": {
                  "type": "integer"
                },
                "struck_through": {
                  "type": "boolean"
                },
                "text": {
                  "type": "string"
                },
                "underlined": {
                  "type": "boolean"
                },
                "unmapped_glyphs": {
                  "type": "integer"
                },
                "visibility": {
                  "type": "string"
                }
              },
              "required": [
                "bbox",
                "boxed",
                "glyph_text",
                "hazards",
                "id",
                "max_contrast",
                "page",
                "struck_through",
                "text",
                "underlined",
                "unmapped_glyphs",
                "visibility"
              ]
            }
          },
          "struck_through_spans": {
            "type": "integer"
          },
          "unmapped_spans": {
            "type": "integer"
          },
          "visible_spans": {
            "type": "integer"
          }
        },
        "required": [
          "actual_text_mismatches",
          "blind_spots",
          "hidden_or_occluded_spans",
          "page",
          "span_count",
          "spans",
          "struck_through_spans",
          "unmapped_spans",
          "visible_spans"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ]
}
