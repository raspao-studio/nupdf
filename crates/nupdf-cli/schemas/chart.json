{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.chart/v1",
  "title": "nupdf.chart/v1",
  "description": "Decompile vector bar, horizontal-bar and line charts plus directed node-edge flowcharts directly from content-stream paths and tick spans.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "charts": {
      "type": "array",
      "items": {}
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "directed": {
                  "type": "boolean"
                },
                "from": {
                  "type": "string"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "directed",
                "from",
                "label",
                "to"
              ]
            }
          },
          "id": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "bbox",
                "id",
                "label"
              ]
            }
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "bbox",
          "edges",
          "id",
          "nodes",
          "page"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "charts",
    "diagnostics",
    "diagrams",
    "doc_id",
    "page_count",
    "schema"
  ]
}
