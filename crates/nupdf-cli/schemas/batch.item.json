{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.batch.item/v1",
  "title": "nupdf.batch.item/v1",
  "description": "Run a command on many files: each as `nupdf <command> <file> ...`, several at once, a JSON line per file in the order given, then the summary.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "error": {
      "$ref": "#/$defs/error"
    },
    "exit": {
      "type": "integer"
    },
    "file": {
      "type": "string"
    },
    "modified": {
      "type": "string"
    },
    "report": {
      "type": [
        "object",
        "null"
      ],
      "description": "the command's report, as it prints it"
    },
    "schema": {
      "type": "string"
    },
    "size": {
      "type": "integer"
    }
  },
  "required": [
    "exit",
    "file",
    "modified",
    "schema",
    "size"
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "message": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    }
  }
}
