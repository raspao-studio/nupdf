{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.attachments/v1",
  "title": "nupdf.attachments/v1",
  "description": "The embedded files: name, file name, type, size, dates, and whether the data matches its checksum; --extract writes each one out.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checksum_ok": {
            "type": "boolean"
          },
          "created": {
            "type": [
              "integer",
              "null"
            ]
          },
          "embedded": {
            "type": "boolean"
          },
          "filename": {
            "type": "string"
          },
          "length": {
            "type": "integer"
          },
          "mimetype": {
            "type": "string"
          },
          "modified": {
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "checksum_ok",
          "created",
          "embedded",
          "filename",
          "length",
          "mimetype",
          "modified",
          "name",
          "size"
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "attachments",
    "diagnostics",
    "doc_id",
    "schema"
  ]
}
