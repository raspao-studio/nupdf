{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.labels/v1",
  "title": "nupdf.labels/v1",
  "description": "Each page's label, as a viewer shows it (`iv`, `A-3`), from the document's page labels or else its number.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ]
}
