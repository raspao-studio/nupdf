{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.annots/v1",
  "title": "nupdf.annots/v1",
  "description": "Each page's annotations (links, popups and form widgets aside): type, box, text, author, colours, dates, and the points of lines, polygons, ink and text markup; or, with --add, --delete or --highlight, write the document with annotations added or removed as MuPDF's annotation API makes them, appearances included.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "annots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "author": {
                  "type": "string"
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "style": {
                      "type": "string"
                    },
                    "width": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "style",
                    "width"
                  ]
                },
                "color": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "contents": {
                  "type": "string"
                },
                "created": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": "object",
                  "properties": {
                    "embedded": {
                      "type": "boolean"
                    },
                    "filename": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "mimetype": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "size": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "embedded",
                    "filename",
                    "mimetype",
                    "size"
                  ]
                },
                "flags": {
                  "type": "integer"
                },
                "icon": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "ink_list": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "interior_color": {
                  "type": "array",
                  "items": {}
                },
                "line": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "modified": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "object": {
                  "type": "integer"
                },
                "opacity": {
                  "type": "number"
                },
                "open": {
                  "type": "boolean"
                },
                "quad_points": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "subject": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "vertices": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "required": [
                "color",
                "contents",
                "created",
                "flags",
                "id",
                "modified",
                "object",
                "opacity",
                "type"
              ]
            }
          },
          "error": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ]
}
