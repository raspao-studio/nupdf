{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.merge/v1",
  "title": "nupdf.merge/v1",
  "description": "Merge the pages of several documents into a new one, with their external links and outline items, as `mutool merge` does.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message",
                "severity"
              ]
            }
          },
          "doc_id": {
            "type": "string"
          },
          "error": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "diagnostics",
          "doc_id",
          "error",
          "pages",
          "path"
        ]
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": "null"
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "objects",
        "verified"
      ]
    }
  },
  "required": [
    "applied",
    "diagnostics",
    "doc_id",
    "inputs",
    "output",
    "page_count",
    "schema",
    "verification"
  ]
}
