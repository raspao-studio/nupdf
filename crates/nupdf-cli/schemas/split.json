{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.split/v1",
  "title": "nupdf.split/v1",
  "description": "Write each range of pages to its own file in a directory, as `clean --pages` writes it: one page per file by default.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output": {
            "type": "object",
            "properties": {
              "blake3": {
                "type": "string"
              },
              "doc_id": {
                "type": "string"
              },
              "len": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "blake3",
              "doc_id",
              "len",
              "path"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "objects": {
                "type": "integer"
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": [
              "objects",
              "verified"
            ]
          }
        },
        "required": [
          "output",
          "pages",
          "verification"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "applied",
    "diagnostics",
    "doc_id",
    "parts",
    "schema"
  ]
}
