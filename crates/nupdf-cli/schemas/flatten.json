{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.flatten/v1",
  "title": "nupdf.flatten/v1",
  "description": "Draw annotations and form fields into their pages and remove them, as MuPDF's bake does (links stay; with fields, the form goes).",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "annots": {
      "type": "integer"
    },
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": "null"
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "pages": {
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "stopped": {
      "type": [
        "null",
        "string"
      ]
    },
    "unmade": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "object": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "error",
          "object",
          "page"
        ]
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "objects",
        "verified"
      ]
    },
    "widgets": {
      "type": "integer"
    }
  },
  "required": [
    "annots",
    "applied",
    "diagnostics",
    "doc_id",
    "output",
    "pages",
    "schema",
    "stopped",
    "unmade",
    "verification",
    "widgets"
  ]
}
