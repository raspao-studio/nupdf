{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.trace/v1",
  "title": "nupdf.trace/v1",
  "description": "List each page's device calls, as MuPDF's run processor makes them for a page's contents.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "array",
                  "boolean",
                  "null",
                  "number",
                  "object",
                  "string"
                ],
                "properties": {
                  "bpc": {
                    "type": "integer"
                  },
                  "colorkey": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "integer"
                    }
                  },
                  "cs": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    }
                  },
                  "decode": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    }
                  },
                  "h": {
                    "type": "integer"
                  },
                  "imagemask": {
                    "type": "boolean"
                  },
                  "interpolate": {
                    "type": "boolean"
                  },
                  "mask": {
                    "$ref": "#/$defs/mask"
                  },
                  "n": {
                    "type": "integer"
                  },
                  "w": {
                    "type": "integer"
                  }
                },
                "required": [
                  "bpc",
                  "colorkey",
                  "cs",
                  "decode",
                  "h",
                  "imagemask",
                  "interpolate",
                  "mask",
                  "n",
                  "w"
                ],
                "items": {
                  "type": [
                    "array",
                    "boolean",
                    "null",
                    "number",
                    "string"
                  ],
                  "items": {
                    "type": [
                      "array",
                      "number",
                      "string"
                    ],
                    "items": {
                      "type": [
                        "array",
                        "number"
                      ],
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ],
  "$defs": {
    "mask": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "bpc": {
          "type": "integer"
        },
        "colorkey": {
          "type": "null"
        },
        "cs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "decode": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "h": {
          "type": "integer"
        },
        "imagemask": {
          "type": "boolean"
        },
        "interpolate": {
          "type": "boolean"
        },
        "mask": {
          "$ref": "#/$defs/mask"
        },
        "n": {
          "type": "integer"
        },
        "w": {
          "type": "integer"
        }
      },
      "required": [
        "bpc",
        "colorkey",
        "cs",
        "decode",
        "h",
        "imagemask",
        "interpolate",
        "mask",
        "n",
        "w"
      ]
    }
  }
}
