{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.pipeline/v1",
  "title": "nupdf.pipeline/v1",
  "description": "Execute a multi-step agent workflow (`info`, `attest` gate, `query`, `${step.var}` interpolation, `patch`, `chart`, `flat_forms`, `apply_plan`, `history` gate, `audit`) in a single in-memory pass.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "aborted": {
      "type": [
        "object",
        "null"
      ]
    },
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "final_doc_id": {
      "type": "string"
    },
    "initial_doc_id": {
      "type": "string"
    },
    "mutated": {
      "type": "boolean"
    },
    "output": {
      "type": [
        "object",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "step-specific output payload"
          },
          "doc_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "step_index": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "doc_id",
          "id",
          "op",
          "step_index"
        ]
      }
    }
  },
  "required": [
    "aborted",
    "applied",
    "diagnostics",
    "doc_id",
    "final_doc_id",
    "initial_doc_id",
    "mutated",
    "output",
    "schema",
    "steps"
  ]
}
