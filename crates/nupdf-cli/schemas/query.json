{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.query/v1",
  "title": "nupdf.query/v1",
  "description": "Query spans and form widgets by spatial relation (`--right-of`, `--below`, `--inside`, `--near-widget`), style and regex, and aggregate numeric values across a single PDF or an entire directory of PDFs.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "aggregation": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "numeric_count": {
          "type": "integer"
        },
        "sum": {
          "type": [
            "number",
            "null"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "count",
        "max",
        "mean",
        "min",
        "numeric_count",
        "sum",
        "values"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_count": {
      "type": "integer"
    },
    "match_count": {
      "type": "integer"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "anchor_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "bold": {
            "type": "boolean"
          },
          "color": {
            "type": "string"
          },
          "distance": {
            "type": [
              "number",
              "null"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "font": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "italic": {
            "type": "boolean"
          },
          "number": {
            "type": [
              "number",
              "null"
            ]
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "anchor_id",
          "bbox",
          "bold",
          "color",
          "distance",
          "file",
          "font",
          "id",
          "italic",
          "number",
          "page",
          "size",
          "text"
        ]
      }
    },
    "schema": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "aggregation",
    "diagnostics",
    "doc_id",
    "file_count",
    "match_count",
    "matches",
    "schema",
    "truncated"
  ]
}
