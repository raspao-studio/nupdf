{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.patch/v1",
  "title": "nupdf.patch/v1",
  "description": "Surgically replace text in spans or lines by content id (`p1.b2.l1.s1=NEW`), preserving baseline position, size, style and color, and verify before writing that neighbours were not collided with or pages overflowed.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fallback_font": {
            "type": "boolean"
          },
          "font_used": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "new_bbox": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            }
          },
          "new_text": {
            "type": "string"
          },
          "old_bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "old_text": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "fallback_font",
          "font_used",
          "id",
          "new_bbox",
          "new_text",
          "old_bbox",
          "old_text",
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    },
    "verification": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {}
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "findings",
        "verified"
      ]
    }
  },
  "required": [
    "applied",
    "diagnostics",
    "doc_id",
    "output",
    "patches",
    "schema",
    "verification"
  ]
}
