{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.search/v1",
  "title": "nupdf.search/v1",
  "description": "Find a needle in the pages' text, as MuPDF searches: each hit with its quads, its text and the content ids of its characters.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "hit_count": {
      "type": "integer"
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "quads": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "page",
          "quads",
          "text"
        ]
      }
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "page_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "error",
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "hit_count",
    "hits",
    "page_count",
    "page_errors",
    "schema",
    "truncated"
  ]
}
