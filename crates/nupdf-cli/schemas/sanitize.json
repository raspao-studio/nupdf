{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.sanitize/v1",
  "title": "nupdf.sanitize/v1",
  "description": "Remove what the document can do besides show itself: JavaScript, Launch, SubmitForm and ImportData, GoToR/GoToE actions and XFA, and by choice web links and embedded files.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "clean": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "properties": {
        "javascript": {
          "type": "integer"
        },
        "launch": {
          "type": "integer"
        },
        "remote": {
          "type": "integer"
        },
        "xfa": {
          "type": "integer"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": "null"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "after": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "after",
              "before",
              "name"
            ]
          }
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "attachments": {
          "type": "boolean"
        },
        "data": {
          "type": "boolean"
        },
        "javascript": {
          "type": "boolean"
        },
        "launch": {
          "type": "boolean"
        },
        "remote": {
          "type": "boolean"
        },
        "uri": {
          "type": "string"
        },
        "xfa": {
          "type": "boolean"
        }
      },
      "required": [
        "attachments",
        "data",
        "javascript",
        "launch",
        "remote",
        "uri",
        "xfa"
      ]
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "object": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "detail",
          "kind",
          "object",
          "path"
        ]
      }
    },
    "schema": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "objects",
        "verified"
      ]
    }
  },
  "required": [
    "applied",
    "clean",
    "counts",
    "diagnostics",
    "doc_id",
    "output",
    "policy",
    "removed",
    "schema",
    "verification"
  ]
}
