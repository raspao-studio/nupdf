{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.history/v1",
  "title": "nupdf.history/v1",
  "description": "Time-travel across incremental `%%EOF` revisions, verify PKCS#7 digital signatures at every historical state, diff text, form fields and annotations, and flag post-signature content or visual occlusion tampering.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "extracted_output": {
      "type": [
        "object",
        "null"
      ]
    },
    "extracted_revision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "repaired": {
      "type": "boolean"
    },
    "revision_count": {
      "type": "integer"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "byte_end": {
            "type": "integer"
          },
          "classification": {
            "type": "string"
          },
          "delta_from_previous": {
            "type": [
              "object",
              "null"
            ]
          },
          "doc_id": {
            "type": "string"
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "revision": {
            "type": "integer"
          },
          "signatures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "covers_whole_revision": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "signatory": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "signed": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string"
                },
                "valid": {
                  "type": "boolean"
                }
              },
              "required": [
                "covers_whole_revision",
                "name",
                "signatory",
                "signed",
                "status",
                "valid"
              ]
            }
          }
        },
        "required": [
          "byte_end",
          "classification",
          "delta_from_previous",
          "doc_id",
          "page_count",
          "revision",
          "signatures"
        ]
      }
    },
    "schema": {
      "type": "string"
    },
    "tampered": {
      "type": "boolean"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "extracted_output",
    "extracted_revision",
    "repaired",
    "revision_count",
    "revisions",
    "schema",
    "tampered"
  ]
}
