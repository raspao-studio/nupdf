{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.stext/v1",
  "title": "nupdf.stext/v1",
  "description": "Each page's structured text, as MuPDF's stext device gathers it from the page's contents: blocks, lines and characters with their quads, origins, fonts and sizes.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocks": {
            "$ref": "#/$defs/blocks"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ],
  "$defs": {
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "blocks": {
            "$ref": "#/$defs/blocks"
          },
          "flags": {
            "type": "integer"
          },
          "index": {
            "type": "integer"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "chars": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": [
                        "array",
                        "number",
                        "string"
                      ],
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "dir": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "wmode": {
                  "type": "integer"
                }
              },
              "required": [
                "bbox",
                "chars",
                "dir",
                "wmode"
              ]
            }
          },
          "raw": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          },
          "transform": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      }
    }
  }
}
