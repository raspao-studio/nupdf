{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.encrypt/v1",
  "title": "nupdf.encrypt/v1",
  "description": "Encrypt with a new security handler, as `clean -E`.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "encryption": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "permissions": {
          "type": "integer"
        }
      },
      "required": [
        "method",
        "permissions"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": "null"
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "schema": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "objects",
        "verified"
      ]
    }
  },
  "required": [
    "applied",
    "diagnostics",
    "doc_id",
    "encryption",
    "output",
    "schema",
    "verification"
  ]
}
