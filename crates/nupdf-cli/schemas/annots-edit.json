{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.annots-edit/v1",
  "title": "nupdf.annots-edit/v1",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "page",
          "type"
        ]
      }
    },
    "applied": {
      "type": "boolean"
    },
    "deleted": {
      "type": "array",
      "items": {}
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "not_deleted": {
      "type": "array",
      "items": {}
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": "null"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "after": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "after",
              "before",
              "name"
            ]
          }
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "schema": {
      "type": "string"
    },
    "unmade": {
      "type": "array",
      "items": {}
    },
    "verification": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "objects",
        "verified"
      ]
    }
  },
  "required": [
    "added",
    "applied",
    "deleted",
    "diagnostics",
    "doc_id",
    "not_deleted",
    "output",
    "schema",
    "unmade",
    "verification"
  ]
}
