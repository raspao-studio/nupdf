{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.fonts/v1",
  "title": "nupdf.fonts/v1",
  "description": "List the fonts the pages use, as `mutool info` finds them, with what each loads as; --extract writes the embedded font programs as `mutool extract` does.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "encoding": {
            "type": [
              "null",
              "string"
            ]
          },
          "load": {
            "type": "object",
            "properties": {
              "embedded": {
                "type": "boolean"
              },
              "error": {
                "type": "string"
              },
              "glyphs": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "program": {
                "type": "string"
              },
              "substitute": {
                "type": "boolean"
              },
              "to_unicode": {
                "type": "boolean"
              },
              "vertical": {
                "type": "boolean"
              }
            }
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "object": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_object": {
            "type": "integer"
          },
          "subtype": {
            "type": "string"
          }
        },
        "required": [
          "encoding",
          "load",
          "name",
          "object",
          "page",
          "page_object",
          "subtype"
        ]
      }
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "page_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "error",
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "fonts",
    "page_count",
    "page_errors",
    "schema"
  ]
}
