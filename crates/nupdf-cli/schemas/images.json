{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.images/v1",
  "title": "nupdf.images/v1",
  "description": "List the images the pages use, as `mutool info` finds them; --extract writes every image XObject as `mutool extract` does.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alternate": {
            "type": [
              "null",
              "string"
            ]
          },
          "bpc": {
            "type": [
              "integer",
              "null"
            ]
          },
          "colorspace": {
            "type": [
              "null",
              "string"
            ]
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "height": {
            "type": "integer"
          },
          "object": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_object": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          }
        },
        "required": [
          "alternate",
          "bpc",
          "colorspace",
          "filters",
          "height",
          "object",
          "page",
          "page_object",
          "width"
        ]
      }
    },
    "object_count": {
      "type": "integer"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "page_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "error",
          "page"
        ]
      }
    },
    "pixmaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "alpha": {
            "type": "boolean"
          },
          "colorspace": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "error": {
            "type": "string"
          },
          "h": {
            "type": "integer"
          },
          "md5": {
            "type": "string"
          },
          "n": {
            "type": "integer"
          },
          "w": {
            "type": "integer"
          }
        }
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "images",
    "page_count",
    "page_errors",
    "schema"
  ]
}
