{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.show/v1",
  "title": "nupdf.show/v1",
  "description": "Show one object (`12`, `12 0 R`) or the trailer (`trailer`).",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "object": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "stream": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "decoded_len": {
          "type": "integer"
        },
        "raw_len": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "data",
        "decoded_len",
        "raw_len",
        "truncated"
      ]
    },
    "value": {
      "$ref": "#/$defs/object"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "object",
    "schema",
    "value"
  ],
  "$defs": {
    "d": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "array",
          "boolean",
          "integer",
          "null",
          "object"
        ],
        "properties": {
          "d": {
            "$ref": "#/$defs/d"
          },
          "n": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "s": {
            "type": "string"
          }
        },
        "items": {
          "type": [
            "array",
            "integer",
            "null",
            "object"
          ],
          "properties": {
            "d": {
              "$ref": "#/$defs/d"
            },
            "n": {
              "type": "string"
            },
            "r": {
              "type": "number"
            },
            "ref": {
              "type": "string"
            },
            "s": {
              "type": "string"
            }
          },
          "items": {
            "type": "object",
            "properties": {
              "d": {
                "$ref": "#/$defs/d"
              },
              "n": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "object": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer"
          ]
        },
        {
          "type": "object",
          "required": [
            "r"
          ],
          "properties": {
            "r": {
              "type": "number",
              "description": "a real"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "n"
          ],
          "properties": {
            "n": {
              "type": "string",
              "description": "a name, #-escaped"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "s"
          ],
          "properties": {
            "s": {
              "type": "string",
              "description": "a string, in hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "description": "a reference, \"12 0 R\""
            }
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        {
          "type": "object",
          "required": [
            "d"
          ],
          "properties": {
            "d": {
              "type": "object",
              "description": "a dictionary",
              "additionalProperties": {
                "$ref": "#/$defs/object"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "stream"
          ],
          "description": "a stream: its dictionary and raw length",
          "properties": {
            "stream": {
              "$ref": "#/$defs/object"
            },
            "raw_len": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
