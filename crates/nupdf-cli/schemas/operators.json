{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.operators/v1",
  "title": "nupdf.operators/v1",
  "description": "List each page's content-stream operators with their operands, as MuPDF's interpreter hands them to a processor.",
