          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "ops": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "array",
                  "number",
                  "object",
                  "string"
                ],
                "properties": {
                  "d": {
                    "type": "object",
                    "properties": {
                      "ActualText": {
                        "type": "object",
                        "properties": {
                          "s": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "s"
                        ]
                      },
                      "Alt": {
                        "type": "object",
                        "properties": {
                          "s": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "s"
                        ]
                      },
                      "Attached": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "n": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "n"
                          ]
                        }
                      },
                      "BBox": {
                        "type": "array",
                        "items": {
                          "type": [
                            "integer",
                            "object"
                          ],
                          "properties": {
                            "r": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "r"
                          ]
                        }
                      },
                      "K": {
                        "type": "integer"
                      },
                      "Lang": {
                        "type": "object",
                        "properties": {
                          "s": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "s"
                        ]
                      },
                      "MCID": {
                        "type": "integer"
                      },
                      "Subtype": {
                        "type": "object",
                        "properties": {
                          "n": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "n"
                        ]
                      },
                      "Title": {
                        "type": "object",
                        "properties": {
                          "s": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "s"
                        ]
                      },
                      "Type": {
                        "type": "object",
                        "properties": {
                          "n": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "n"
                        ]
                      }
                    }
                  },
                  "n": {
                    "type": "string"
                  }
                },
                "items": {
                  "type": [
                    "number",
                    "object",
                    "string"
                  ],
                  "properties": {
                    "n": {
                      "type": "string"
                    },
                    "s": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ]
}
