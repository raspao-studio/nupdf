{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.cloak/v1",
  "title": "nupdf.cloak/v1",
  "description": "Replace sensitive PII and custom entities across streams, forms, annotations, metadata and outlines with reversible format-preserving synthetic tokens, write a secret mapping vault, and verify zero leaks.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "cloaked_doc_id": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "entities_cloaked": {
      "type": "integer"
    },
    "original_doc_id": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "replacements": {
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "token_preview": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "occurrences": {
            "type": "integer"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "occurrences",
          "token"
        ]
      }
    },
    "vault_path": {
      "type": "string"
    },
    "verified_zero_leaks": {
      "type": "boolean"
    }
  },
  "required": [
    "applied",
    "cloaked_doc_id",
    "diagnostics",
    "doc_id",
    "entities_cloaked",
    "original_doc_id",
    "output",
    "replacements",
    "schema",
    "token_preview",
    "vault_path",
    "verified_zero_leaks"
  ]
}
