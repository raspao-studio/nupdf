{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.render/v1",
  "title": "nupdf.render/v1",
  "description": "Render pages as `mutool draw` paints them (page contents, then annotations, then form fields), into page-NNNN.png (or .ppm) files.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "dpi": {
      "type": "number"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "height": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          }
        },
        "required": [
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "dpi",
    "page_count",
    "pages",
    "schema"
  ]
}
