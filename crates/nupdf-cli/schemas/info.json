{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.info/v1",
  "title": "nupdf.info/v1",
  "description": "Identify a file and report what nupdf can tell about it.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "encrypted": {
      "type": "boolean"
    },
    "encryption": {
      "type": "string"
    },
    "file_size": {
      "type": "integer"
    },
    "header_offset": {
      "type": [
        "integer",
        "null"
      ]
    },
    "header_version": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "linearized": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "Author": {
          "type": "string"
        },
        "CreationDate": {
          "type": "string"
        },
        "Creator": {
          "type": "string"
        },
        "Keywords": {
          "type": "string"
        },
        "ModDate": {
          "type": "string"
        },
        "Producer": {
          "type": "string"
        },
        "Subject": {
          "type": "string"
        },
        "Title": {
          "type": "string"
        }
      }
    },
    "needs_password": {
      "type": "boolean"
    },
    "object_count": {
      "type": "integer"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pdf_version": {
      "type": "string"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "accessibility": {
          "type": "boolean"
        },
        "annotate": {
          "type": "boolean"
        },
        "assemble": {
          "type": "boolean"
        },
        "copy": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "form": {
          "type": "boolean"
        },
        "print": {
          "type": "boolean"
        },
        "print-hq": {
          "type": "boolean"
        }
      },
      "required": [
        "accessibility",
        "annotate",
        "assemble",
        "copy",
        "edit",
        "form",
        "print",
        "print-hq"
      ]
    },
    "repaired": {
      "type": "boolean"
    },
    "revision_offsets": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "revisions": {
      "type": "integer"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "encrypted",
    "encryption",
    "file_size",
    "header_offset",
    "header_version",
    "kind",
    "linearized",
    "metadata",
    "needs_password",
    "object_count",
    "page_count",
    "pdf_version",
    "permissions",
    "repaired",
    "revision_offsets",
    "revisions",
    "schema"
  ]
}
