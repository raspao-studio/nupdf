{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.apply/v1",
  "title": "nupdf.apply/v1",
  "description": "Execute one or more declarative JSON edit plans anchored to the base `doc_id`, checking cross-agent semantic and spatial conflicts before committing and verifying the combined output atomically.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "annotations_deleted": {
      "type": "integer"
    },
    "applied": {
      "type": "boolean"
    },
    "conflicts": {
      "type": "array",
      "items": {}
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent": {
            "type": [
              "null",
              "string"
            ]
          },
          "agent_of": {
            "type": [
              "null",
              "string"
            ]
          },
          "op": {
            "type": "integer"
          },
          "same_as": {
            "type": "integer"
          }
        },
        "required": [
          "agent",
          "agent_of",
          "op",
          "same_as"
        ]
      }
    },
    "fields_changed": {
      "type": "integer"
    },
    "highlights_added": {
      "type": "integer"
    },
    "op_count": {
      "type": "integer"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": [
            "null",
            "string"
          ]
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "after": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "after",
              "before",
              "name"
            ]
          }
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "pages_kept": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer"
      }
    },
    "patch_verification": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {}
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "findings",
        "verified"
      ]
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fallback_font": {
            "type": "boolean"
          },
          "font_used": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "new_bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "new_text": {
            "type": "string"
          },
          "old_bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "old_text": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "fallback_font",
          "font_used",
          "id",
          "new_bbox",
          "new_text",
          "old_bbox",
          "old_text",
          "page"
        ]
      }
    },
    "plan_count": {
      "type": "integer"
    },
    "redact_verified": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "redaction_quads": {
      "type": "integer"
    },
    "rotated": {
      "type": [
        "integer",
        "null"
      ]
    },
    "sanitized_items": {
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "required": [
    "annotations_deleted",
    "applied",
    "conflicts",
    "diagnostics",
    "doc_id",
    "duplicates",
    "fields_changed",
    "highlights_added",
    "op_count",
    "output",
    "pages_kept",
    "patch_verification",
    "patches",
    "plan_count",
    "redact_verified",
    "redaction_quads",
    "rotated",
    "sanitized_items",
    "schema",
    "verified"
  ]
}
