{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.outline/v1",
  "title": "nupdf.outline/v1",
  "description": "The outline (bookmarks): each entry's title, link, whether it is open, the page it leads to, and the entries below it.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "down": {
            "$ref": "#/$defs/down"
          },
          "open": {
            "type": "boolean"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "uri": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "open",
          "page",
          "title",
          "uri"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "items",
    "schema"
  ],
  "$defs": {
    "down": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "down": {
            "$ref": "#/$defs/down"
          },
          "open": {
            "type": "boolean"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "uri": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "open",
          "page",
          "title",
          "uri"
        ]
      }
    }
  }
}
