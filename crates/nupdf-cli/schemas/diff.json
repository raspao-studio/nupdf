{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.diff/v1",
  "title": "nupdf.diff/v1",
  "description": "Compare two PDFs: their text (pages lined up, then lines, with content ids), their structure (pages, sizes, metadata, outline, fonts, annotations) and, on request, their pixels.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "a": {
      "type": "object",
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "doc_id",
        "file",
        "page_count"
      ]
    },
    "b": {
      "type": "object",
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "doc_id",
        "file",
        "page_count"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "document",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "identical": {
      "type": "boolean"
    },
    "pixels": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "dpi": {
          "type": "number"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "a_error": {
                "type": "string"
              },
              "b_error": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              }
            },
            "required": [
              "a_error",
              "b_error",
              "page"
            ]
          }
        },
        "same": {
          "type": "boolean"
        }
      },
      "required": [
        "dpi",
        "pages",
        "same"
      ]
    },
    "schema": {
      "type": "string"
    },
    "structure": {
      "type": "object",
      "properties": {
        "differences": {
          "type": "array",
          "items": {}
        },
        "same": {
          "type": "boolean"
        }
      },
      "required": [
        "differences",
        "same"
      ]
    },
    "text": {
      "type": "object",
      "properties": {
        "a_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              }
            },
            "required": [
              "error",
              "page"
            ]
          }
        },
        "b_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              }
            },
            "required": [
              "error",
              "page"
            ]
          }
        },
        "pages": {
          "type": "array",
          "items": {}
        },
        "same": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "a_errors",
        "b_errors",
        "pages",
        "same",
        "truncated"
      ]
    }
  },
  "required": [
    "a",
    "b",
    "diagnostics",
    "doc_id",
    "identical",
    "pixels",
    "schema",
    "structure",
    "text"
  ]
}
