{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.links/v1",
  "title": "nupdf.links/v1",
  "description": "Each page's links: their boxes, where they lead (a URI, and the page for a link inside the document).",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "uri": {
                  "type": "string"
                }
              },
              "required": [
                "bbox",
                "page",
                "uri"
              ]
            }
          },
          "page": {
            "type": "integer"
          }
        },
        "required": [
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ]
}
