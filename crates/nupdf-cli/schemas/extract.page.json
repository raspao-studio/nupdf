{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.extract.page/v1",
  "title": "nupdf.extract.page/v1",
  "description": "Extract the pages' text with content ids (p3, p3.b2, p3.b2.l4, p3.b2.l4.s1): as JSON with blocks, lines and spans and their boxes and fonts, as JSON lines (a page per line), as plain text (as `mutool draw -F txt` writes it) or as Markdown.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "id": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "dir": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "id": {
                  "type": "string"
                },
                "spans": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "bbox": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      "bold": {
                        "type": "boolean"
                      },
                      "color": {
                        "type": "string"
                      },
                      "font": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "italic": {
                        "type": "boolean"
                      },
                      "size": {
                        "type": "number"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "bbox",
                      "bold",
                      "color",
                      "font",
                      "id",
                      "italic",
                      "size",
                      "text"
                    ]
                  }
                },
                "wmode": {
                  "type": "integer"
                }
              },
              "required": [
                "bbox",
                "dir",
                "id",
                "spans",
                "wmode"
              ]
            }
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "bbox",
          "id",
          "lines",
          "type"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "page": {
      "type": "integer"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "doc_id",
    "id",
    "schema"
  ]
}
