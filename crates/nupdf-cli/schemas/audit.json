{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.audit/v1",
  "title": "nupdf.audit/v1",
  "description": "Deterministically verify quotes and citations against a PDF with zero model tokens: checks `doc_id`, content ids, pages, epistemic hazards (strikethroughs, omitted footnotes, ActualText spoofs, invisible text, post-signature edits), and renders highlighted PNG evidence cards.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "all_verified": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "failed": {
      "type": "integer"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actual_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "cited_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_quote": {
            "type": "string"
          },
          "footnote_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "found_elsewhere": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hazards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer"
          },
          "resolved_bbox": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            }
          },
          "resolved_page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "actual_text",
          "cited_id",
          "claim_id",
          "evidence_file",
          "expected_quote",
          "footnote_text",
          "found_elsewhere",
          "hazards",
          "index",
          "resolved_bbox",
          "resolved_page",
          "status",
          "verified"
        ]
      }
    },
    "schema": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "verified_clean": {
      "type": "integer"
    },
    "verified_with_hazards": {
      "type": "integer"
    }
  },
  "required": [
    "all_verified",
    "diagnostics",
    "doc_id",
    "failed",
    "results",
    "schema",
    "total",
    "verified_clean",
    "verified_with_hazards"
  ]
}
