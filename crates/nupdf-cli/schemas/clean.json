{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.clean/v1",
  "title": "nupdf.clean/v1",
  "description": "Rewrite the whole document as `mutool clean` does: every object in a plain xref table, object and xref streams unpacked, encryption kept.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "encryption": {
      "type": "string"
    },
    "garbage": {
      "type": "integer"
    },
    "objstms": {
      "type": "boolean"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": [
            "null",
            "string"
          ]
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "after": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "after",
              "before",
              "name"
            ]
          }
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "pages": {
      "type": "null"
    },
    "schema": {
      "type": "string"
    },
    "streams": {
      "type": "object",
      "properties": {
        "ascii": {
          "type": "boolean"
        },
        "compress": {
          "type": "boolean"
        },
        "compress_fonts": {
          "type": "boolean"
        },
        "compress_images": {
          "type": "boolean"
        },
        "decompress": {
          "type": "boolean"
        },
        "effort": {
          "type": "integer"
        }
      },
      "required": [
        "ascii",
        "compress",
        "compress_fonts",
        "compress_images",
        "decompress",
        "effort"
      ]
    },
    "syntax": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "objects",
        "verified"
      ]
    }
  },
  "required": [
    "applied",
    "diagnostics",
    "doc_id",
    "encryption",
    "garbage",
    "objstms",
    "output",
    "pages",
    "schema",
    "streams",
    "syntax",
    "verification"
  ]
}
