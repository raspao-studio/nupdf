{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.tables/v1",
  "title": "nupdf.tables/v1",
  "description": "Each page's tables as rows of cells, found as MuPDF's table hunting finds them (`stext --options table-hunt`).",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": "string"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "columns": {
                  "type": "integer"
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "bbox": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      "cells": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "bbox": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            "text": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "bbox",
                            "text"
                          ]
                        }
                      }
                    },
                    "required": [
                      "bbox",
                      "cells"
                    ]
                  }
                }
              },
              "required": [
                "bbox",
                "columns",
                "rows"
              ]
            }
          }
        },
        "required": [
          "page"
        ]
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "diagnostics",
    "doc_id",
    "page_count",
    "pages",
    "schema"
  ]
}
