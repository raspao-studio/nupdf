{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.uncloak/v1",
  "title": "nupdf.uncloak/v1",
  "description": "Restore synthetic tokens back to original secrets in an agent-edited PDF (or in UTF-8 text/JSON with `--text-mode`) using a cloak vault.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "cloaked_doc_id": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ]
      }
    },
    "doc_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "entities_restored": {
      "type": "integer"
    },
    "mode": {
      "type": "string"
    },
    "original_doc_id": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "len": {
          "type": "integer"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "blake3",
        "doc_id",
        "len",
        "path"
      ]
    },
    "replacements": {
      "type": "integer"
    },
    "restored_doc_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "applied",
    "cloaked_doc_id",
    "diagnostics",
    "doc_id",
    "entities_restored",
    "mode",
    "original_doc_id",
    "output",
    "replacements",
    "restored_doc_id",
    "schema"
  ]
}
