{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nupdf.batch/v1",
  "title": "nupdf.batch/v1",
  "description": "Run a command on many files: each as `nupdf <command> <file> ...`, several at once, a JSON line per file in the order given, then the summary.",
  "$comment": "Generated by `cargo xtask schemas` from the reports on the smoke tier and a sample of the standard tier.",
  "type": "object",
  "properties": {
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {}
    },
    "doc_id": {
      "type": "null"
    },
    "failed": {
      "type": "integer"
    },
    "files": {
      "type": "integer"
    },
    "not_run": {
      "type": "integer"
    },
    "ok": {
      "type": "integer"
    },
    "output": {
      "type": "null"
    },
    "schema": {
      "type": "string"
    },
    "skipped": {
      "type": "integer"
    }
  },
  "required": [
    "command",
    "diagnostics",
    "doc_id",
    "failed",
    "files",
    "not_run",
    "ok",
    "output",
    "schema",
    "skipped"
  ]
}
